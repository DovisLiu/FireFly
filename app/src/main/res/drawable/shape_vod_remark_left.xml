<?xml version="1.0" encoding="utf-8"?>
<!-- Round 38 / R3（刘先生真机实测「左上角标与右上角标在字号/文字色/内边距/圆角上不一致」）：
     本文件是 shape_vod_remark.xml（右上角标规格）的**水平镜像**，专供贴在海报**左上角**的角标使用。
     规格与右上完全同族：底色 @color/bg_remark、内边距 上下 3dp / 左右 5dp、圆角语言 12dp 外角 + 6dp 内角；
     镜像映射 TL↔TR、BL↔BR，故外角落在 top-left（随海报 Vod.Grid 的 12dp 圆角，main/res/values/styles.xml:8），
     内角 6dp 落在 bottom-right。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/bg_remark" />

    <padding
        android:bottom="3dp"
        android:left="5dp"
        android:right="5dp"
        android:top="3dp" />

    <corners
        android:topLeftRadius="12dp"
        android:topRightRadius="0dp"
        android:bottomRightRadius="6dp"
        android:bottomLeftRadius="0dp" />

</shape>
