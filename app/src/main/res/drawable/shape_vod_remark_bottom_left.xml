<?xml version="1.0" encoding="utf-8"?>
<!-- Round 38 / R3：海报**左下角**角标（历史/收藏网格卡的"更新至 …"一类，layout_above=name）用的形状。
     与右上角标同规格（底色 @color/bg_remark、内边距 上下 3dp / 左右 5dp、外角 12dp 随海报 Vod.Grid 圆角、
     内角 6dp），只是镜像方向改为**垂直镜像**（外角落在 bottom-left，内角落在 top-right）。
     原实现直接复用右上角标形状（外角 12dp 悬在海报中部）→ 同族角标形状语言不统一，本文件收口。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/bg_remark" />

    <padding
        android:bottom="3dp"
        android:left="5dp"
        android:right="5dp"
        android:top="3dp" />

    <corners
        android:topLeftRadius="0dp"
        android:topRightRadius="6dp"
        android:bottomRightRadius="0dp"
        android:bottomLeftRadius="12dp" />

</shape>
