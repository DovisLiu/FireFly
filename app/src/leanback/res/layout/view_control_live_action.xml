<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- β43 / A2（菜单改名与移位）：原第 1 项「配置」＝实际选直播源，改名为「换源」并移到本排最后
             （见文件末尾）；原第 14 项「换源」（实际是切线路、与第 4 项「线路」重叠）已删除，
             故这里原先指向 @id/change 的环绕 nextFocusLeft 改挂到新的末项（home 反向指 config）。 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/home"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:nextFocusLeft="@id/config"
            tools:text="首页" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/action"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/line"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            tools:text="来源 1"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/player"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_exo" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/decode"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_decode" />

        <com.firefly.tv.ui.custom.CustomUpDownView
            android:id="@+id/speed"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:fontFeatureSettings="tnum"
            android:text="@string/play_speed"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/scale"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_scale" />

        <com.firefly.tv.ui.custom.CustomUpDownView
            android:id="@+id/text"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:tag="3"
            android:text="@string/play_track_text"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/audio"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:tag="1"
            android:text="@string/play_track_audio" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/video"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:tag="2"
            android:text="@string/play_track_video" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/invert"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_invert" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/across"
            style="@style/Control"
            android:layout_marginEnd="8dp"
            android:text="@string/play_across" />

        <!-- 末项＝「换源」（id 仍是 config，点击回调一字未动：LiveActivity#onConfig 起直播源选择窗）。
             原名「配置」与实际功能不符（A2 改名）；`play_config` 这个 key 仍在 main，但自 β68 手机批起
             手机那一排也改引 `play_change`／`play_switch_line`，全仓对它**已无引用**（实测：arsc 里它已从手机包与 TV 包双双消失），
             留着只是历史，
             故只换本项引用，不动资源本身。原末项「换源」（id=change，实际是切线路、与第 4 项「线路」重复）删除。 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/config"
            style="@style/Control"
            android:nextFocusRight="@id/home"
            android:text="@string/play_change" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</HorizontalScrollView>
