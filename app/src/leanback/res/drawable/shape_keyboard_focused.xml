<?xml version="1.0" encoding="utf-8"?>
<!-- Round 38 / R5①：搜索页虚拟键盘按键焦点态 = 提亮底 + 2dp 描边（与 chip 族同表达）。
     原"black_30 底 + 白描边"在浅色主题（搜索页是主题底页面）上：白描边看不见、深底配主题深字不可读。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/focus_card" />

    <corners android:radius="4dp" />

    <stroke
        android:width="@dimen/state_stroke_focus"
        android:color="@color/state_focus_stroke" />

</shape>