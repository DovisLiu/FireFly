<?xml version="1.0" encoding="utf-8"?>
<!-- Round 38 / R5①（Q-2：卡片类只统一焦点态，不设选中列）：海报卡焦点描边由"1.5dp #B3000000 硬编码黑"
     换成全站单点 @dimen/state_stroke_focus + @color/state_focus_stroke。
     原黑描边在深色模式的深页面底上几乎不可见（深色档焦点全靠 scale，描边等于没画），
     换 token 后浅色=深描边、深色=近白描边，两档都可见，且与列表行/胶囊同一套语言。
     注意：焦点态只有描边、不加提亮底——海报卡是图片铺满的，加底会盖住海报（R5 判据里"轻微提亮底"
     适用于纯色底控件）；焦点差异由描边 + 1.05 scale 共同承担。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="8dp" />

    <stroke
        android:width="@dimen/state_stroke_focus"
        android:color="@color/state_focus_stroke" />

</shape>