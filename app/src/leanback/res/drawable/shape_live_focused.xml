<?xml version="1.0" encoding="utf-8"?>
<!-- Round 38 / R5①：直播节目单行（EPG，恒深底）焦点态 = 2dp 描边 + 轻微提亮底。
     原只有 1.5dp 白描边、无提亮底 → 与频道卡/列表行的焦点表达不一致；现同一条语言（on_dark 族）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="4dp" />

    <solid android:color="@color/on_dark_focus_bg" />

    <stroke
        android:width="@dimen/state_stroke_focus"
        android:color="@color/on_dark_focus_stroke" />

    <padding
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp" />

</shape>
