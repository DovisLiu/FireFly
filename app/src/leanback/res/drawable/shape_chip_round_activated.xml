<?xml version="1.0" encoding="utf-8"?>
<!-- Round 38 / R5①：圆胶囊选中态 = 1.5dp 描边 + 更弱底（与 shape_chip_activated 同表达）。
     原文件与常规态完全相同（无任何选中表达）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="28dp" />

    <padding
