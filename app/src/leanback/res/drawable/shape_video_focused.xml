<?xml version="1.0" encoding="utf-8"?>
<!-- Round 38 / R5①：播放页画面框（activity_video 的 @+id/video，底色恒 @color/black）焦点态。
     恒深底 → 用 on_dark_* 族（日夜同值的白描边，浅色主题下也不会出现深描边压深底不可见），
     宽度收进全站单点 @dimen/state_stroke_focus（原写死 1.5dp）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <stroke
        android:width="@dimen/state_stroke_focus"
        android:color="@color/on_dark_focus_stroke" />

</shape>