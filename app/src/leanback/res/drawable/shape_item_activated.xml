<?xml version="1.0" encoding="utf-8"?>
<!-- Round 38 / R5①：列表行/设置行/弹窗选项选中态 = 1.5dp 描边 + 更弱底。
     原写法是"整块实心容器色（@color/brand_primary_container，去紫前是紫底）+ 无描边"，
     与焦点态的关系是"反色块 vs 描边"两套语言，跨页面不统一 → 现收敛到全站一条语言：
     焦点 2dp、选中 1.5dp、常规无描边；选中底取比 focus_card 沉一档的不透明中性灰（更弱底），
     在白卡、浅色页面底、深色模式卡片和详情页海报上都能看见。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/state_select_bg" />
    <corners android:radius="@dimen/pill_radius" /> <!-- β19 / T-312：14dp→胶囊，引用与首页导航同一 dimen -->
    <stroke
        android:width="@dimen/state_stroke_select"
        android:color="@color/state_select_stroke" />
    <padding
        android:bottom="12dp"
        android:left="16dp"
        android:right="16dp"
        android:top="12dp" />
</shape>
