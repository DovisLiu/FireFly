<resources>

    <style name="Theme.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- β82 Q4＝乙（刘先生「现有的返回箭头太丑，需要换一个图标」）：顶栏返回箭头在此一处收口。
             此前全仓无该项覆盖（实测 0 命中）⇒ 现 7 处 setDisplayHomeAsUpEnabled 的页都吃默认形；
             指到新建矢量后那 8 页与新增的 6 个工具条同形。**换款只换那一个矢量文件，theme 与各页都不动。** -->
        <item name="homeAsUpIndicator">@drawable/ic_nav_back</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="android:colorBackground">@color/bg_page</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorSurfaceContainer">@color/bg_card</item>
        <!-- β19 / T-315（手机侧）：全站弹窗的底色/文字色在此一处收口。
             此前 AlertDialog 走 ?attr/colorSurfaceContainerHigh、BottomSheet 走 ?attr/colorSurfaceContainerLow，
             两者本项目都没赋值 ⇒ 回落 Material 的 M3 基线紫板（浅 #ECE6F0／深 #2B2930，
             弹窗内文字 #E6E0E9、正文 #CAC4D0 同样带紫）。现在全部指到与设置页同一族的中性 token：
             浅＝#FFFFFF（设置页卡片底同值）、深＝#1E2126；文字色走 popup_on_surface(_variant)。
             日夜自动切换靠 values / values-night 的**同名成对** token，不是靠本行写两遍。 -->
        <item name="colorSurfaceContainerHigh">@color/popup_surface</item>
        <item name="colorSurfaceContainerLow">@color/popup_surface</item>
        <item name="colorOnSurface">@color/popup_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/popup_on_surface_variant</item>
        <!-- β19 / T-315：手机侧本轮**只改底色/文字色**（上面四行属性），不改弹窗圆角 overlay：
             Theme.App.Popup 与 Shape.App.Pill 定义在 leanback 源集里，mobile 引不到；
             且 mobile 的 FAB 与弹窗共用 shapeAppearanceCornerExtraLarge，全局改会变形。
             手机侧弹窗圆角列为待办，等 TV 验收后另批。 -->
        <item name="colorSecondaryContainer">@color/brand_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_primary_container</item>
        <!-- β39 / beta70 批 1 第 1 项（上方 β19 注释里那条"待办"就是本行）：手机弹窗容器圆角收 16dp。
             做法照 leanback/res/values/styles.xml:24 的同一套——**只覆盖 materialAlertDialogTheme**，
             不动全局 shapeAppearanceCornerExtraLarge（手机 FAB 在用那个属性，全局改会变形）。
             上一轮盘点的实测依据：全仓 `new MaterialAlertDialogBuilder(...)` 全是单参、没有一处传
             themeResId（β39 批 1 测得 mobile 8／leanback 6／main 2；**β70 批 3 重测＝mobile 10／leanback 8／main 2**，
             正则含 `new com.google...MaterialAlertDialogBuilder(` 这种全限定写法），所以容器圆角只由主题的这一个属性决定；
             改这一处即覆盖 dialog_*.xml（现为 28 个，β39 时 27 个，差在批 2 新建的 dialog_desc）与直接建 builder 的那批弹窗。
             同名 style 在 mobile 源集自己建一份（flavor 资源不与 leanback 合并，不存在"引不到"，
             β19 那条注释的说法本轮已按实测订正在上方，原文保留不改）。 -->
        <item name="materialAlertDialogTheme">@style/Theme.App.Popup</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:fontFamily">@font/misans</item>
        <item name="fontFamily">@font/misans</item>
        <item name="android:textViewStyle">@style/Text.App</item>
        <item name="materialButtonStyle">@style/Button.App</item>
    </style>

    <style name="Text.App" parent="android:Widget.Material.TextView">
        <item name="android:fontFamily">@font/misans</item>
        <item name="fontFamily">@font/misans</item>
    </style>

    <style name="Button.App" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/misans</item>
        <item name="fontFamily">@font/misans</item>
        <item name="shapeAppearanceOverlay">@style/Shape.Pill</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Shape.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- β39 / beta70：手机侧弹窗专用 ThemeOverlay（与 leanback 那份同名、各自源集一份，互不影响）。
         parent 用 Material 现成的 MaterialAlertDialog overlay，其余属性继续吃 Theme.Base 的覆盖结果；
         这里只换弹窗容器的四角形状，其余一概不动。 -->
    <style name="Theme.App.Popup" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceCornerExtraLarge">@style/Shape.App.Dialog</item>
        <!-- β69 / 批 2（A 派单第 6 项，甲段）：弹窗正文走 Material3 默认的那批改由本 overlay 定档 13.5sp／行距 1.26。
             β69 当时写「全 mobile 4 处 setMessage」「27 个 setView(dialog_*.xml)」——**β70 批 3 按实测订正，旧口径留此不抹**：
             setMessage 现为 3 处（DetailActivity 那处已在批 2 改成 setView，现为 HistoryActivity:77、KeepActivity:80、
             SettingFragment:235）；`dialog_*.xml` 现为 28 个（含批 2 新建的 dialog_desc）、`.setView(` 调用点 15 处
             （三源集＝mobile 15／leanback 16／main 2；行号须在该文件最后一次编辑后重读，β82 之后已漂移）。自定义弹窗不吃这个属性（内容字号在各自布局里写死）。 -->
        <item name="materialAlertDialogBodyTextStyle">@style/Text.App.Popup.Body</item>
    </style>

    <style name="Text.App.Popup.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/popup_text_body</item>
        <item name="android:lineSpacingMultiplier">1.26</item>
    </style>

    <!-- 弹窗容器＝四角等值 16dp（@dimen/radius_sheet），禁 pill（同 β21/T-331 的裁定）。 -->
    <style name="Shape.App.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sheet</item>
    </style>

    <style name="Widget.App.Nav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
        <item name="shapeAppearanceOverlay">@style/Shape.Pill</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="windowSplashScreenBackground">#F2F7FA</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <style name="Theme.App" parent="Theme.Base" />

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/yellow</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="ToolbarTextAppearance" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/misans</item>
        <item name="fontFamily">@font/misans</item>
    </style>

</resources>
