<?xml version="1.0" encoding="utf-8"?>
<!-- β31 A3/A7/A8：选集横卡对齐线路卡 adapter_flag＝height wrap_content＋paddingTop/Bottom 8dp＋paddingStart/End 12dp＋textSize 13sp，
     不再固定 22dp（改前矮/贴边/单字密）。A8 加 minWidth 40dp（单数字时不太小太密）。
     宽度策略不动（A7）：仍 wrap_content＋代码侧 maxWidth，singleLine＋marquee 保留（长名不折行）。 -->
<com.google.android.material.textview.MaterialTextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/text"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/selector_card_bg"
    android:ellipsize="marquee"
    android:gravity="center"
    android:minWidth="40dp"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp"
    android:singleLine="true"
    android:textColor="?android:attr/textColorPrimary"
    android:textSize="13sp"
    tools:text="20" />